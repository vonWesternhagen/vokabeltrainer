{
  "name": "vokabeltrainer",
  "version": "4.6.2",
  "private": true,
  "description": "Browserbasierter Vokabeltrainer \u2013 Entwicklungs- und Regressionstests",
  "scripts": {
    "check": "node --check app.js && node --check data-core.js && node --check sw.js && node --check online-backup.js",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium --project=chromium-ipad-portrait --project=chromium-ipad-landscape",
    "test:webkit": "playwright test --project=webkit --project=webkit-ipad-portrait --project=webkit-ipad-landscape",
    "test:install-browsers": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium webkit",
    "test:report": "playwright show-report",
    "test:unit": "node --test unit/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
